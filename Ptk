from tkinter import *
from PIL import Image, ImageTk

root = Tk()
root.title("Login System")
root.geometry("500x400")

# Background Image
img = Image.open("login.jpg")
img = img.resize((500, 400))
bg = ImageTk.PhotoImage(img)

Label(root, image=bg).place(x=0, y=0)

# Login Frame
frame = Frame(root, bg="white", padx=20, pady=20)
frame.place(relx=0.5, rely=0.5, anchor=CENTER)

Label(frame, text="Username", bg="white").grid(row=0, column=0, pady=5)
username = Entry(frame)
username.grid(row=0, column=1)

Label(frame, text="Password", bg="white").grid(row=1, column=0, pady=5)
password = Entry(frame, show="*")
password.grid(row=1, column=1)

Button(frame, text="Login").grid(row=2, column=0, columnspan=2, pady=10)

root.mainloop()
