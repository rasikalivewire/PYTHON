-- ============================================
-- 1. CREATE DATABASE
-- ============================================

CREATE DATABASE shopping;

USE shopping;


-- ============================================
-- 2. CREATE TABLE
-- ============================================

CREATE TABLE products (
    product_id INT PRIMARY KEY AUTO_INCREMENT,
    product_name VARCHAR(50),
    category VARCHAR(30),
    price DECIMAL(10,2),
    quantity INT
);


