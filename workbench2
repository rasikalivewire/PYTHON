-- ============================================
-- 4. DISPLAY ALL RECORDS
-- ============================================

SELECT * FROM products;


-- ============================================
-- 5. SELECT SPECIFIC COLUMNS
-- ============================================

SELECT product_name, price
FROM products;


SELECT product_name, category, price
FROM products;


-- ============================================
-- 6. WHERE CONDITION
-- ============================================

SELECT *
FROM products
WHERE price > 2000;


SELECT *
FROM products
WHERE category = 'Electronics';


SELECT *
FROM products
WHERE quantity < 20;


-- ============================================
-- 7. AND OPERATOR
-- ============================================

SELECT *
FROM products
WHERE price > 5000
AND quantity > 10;


-- ============================================
-- 8. OR OPERATOR
-- ============================================

SELECT *
FROM products
WHERE category = 'Electronics'
OR category = 'Wearables';


-- ============================================
-- 9. NOT OPERATOR
-- ============================================

SELECT *
FROM products
WHERE NOT category = 'Accessories';


-- ============================================
-- 10. BETWEEN
-- ============================================

SELECT *
FROM products
WHERE price BETWEEN 1000 AND 10000;


-- ============================================
-- 11. IN
-- ============================================

SELECT *
FROM products
WHERE category IN ('Electronics', 'Wearables');


-- ============================================
-- 12. LIKE
-- ============================================

-- Product names starting with M
SELECT *
FROM products
WHERE product_name LIKE 'M%';


-- Product names ending with e
SELECT *
FROM products
WHERE product_name LIKE '%e';


-- Product names containing "oo"
SELECT *
FROM products
WHERE product_name LIKE '%oo%';


-- ============================================
-- 13. ORDER BY
-- ============================================

-- Lowest to highest price
SELECT *
FROM products
ORDER BY price ASC;


-- Highest to lowest price
SELECT *
FROM products
ORDER BY price DESC;


-- Sort by quantity
SELECT *
FROM products
ORDER BY quantity DESC;


-- ============================================
-- 14. LIMIT
-- ============================================

-- Display first 5 products
SELECT *
FROM products
LIMIT 5;


-- Display top 3 expensive products
SELECT *
FROM products
ORDER BY price DESC
LIMIT 3;


-- ============================================
-- 15. DISTINCT
-- ============================================

SELECT DISTINCT category
FROM products;


-- ============================================
-- 16. UPDATE
-- ============================================

-- Change laptop price
UPDATE products
SET price = 60000
WHERE product_name = 'Laptop';


-- Increase mouse quantity
UPDATE products
SET quantity = quantity + 10
WHERE product_name = 'Mouse';


-- Increase all Electronics prices by 5%
UPDATE products
SET price = price * 1.05
WHERE category = 'Electronics';


-- Check updated data
SELECT * FROM products;


-- ============================================
-- 17. DELETE
-- ============================================

-- Delete one product
DELETE FROM products
WHERE product_name = 'USB Cable';


-- Delete products with quantity less than 10
DELETE FROM products
WHERE quantity < 10;


-- Check data
SELECT * FROM products;


-- ============================================
-- 18. AGGREGATE FUNCTIONS
-- ============================================

-- Total quantity
SELECT SUM(quantity) AS total_quantity
FROM products;


-- Average price
SELECT AVG(price) AS average_price
FROM products;


-- Highest price
SELECT MAX(price) AS highest_price
FROM products;


-- Lowest price
SELECT MIN(price) AS lowest_price
FROM products;


-- Number of products
SELECT COUNT(*) AS total_products
FROM products;


-- ============================================
-- 19. GROUP BY
-- ============================================

-- Number of products in each category
SELECT category, COUNT(*) AS total_products
FROM products
GROUP BY category;


-- Average price of each category
SELECT category, AVG(price) AS average_price
FROM products
GROUP BY category;


-- Total quantity in each category
SELECT category, SUM(quantity) AS total_quantity
FROM products
GROUP BY category;


-- ============================================
-- 20. HAVING
-- ============================================

-- Categories having more than 2 products
SELECT category, COUNT(*) AS total_products
FROM products
GROUP BY category
HAVING COUNT(*) > 2;


-- Categories with average price above 5000
SELECT category, AVG(price) AS average_price
FROM products
GROUP BY category
HAVING AVG(price) > 5000;


